# IntervuX Environment Configuration

# Database Configuration
# PostgreSQL (default in Docker):
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/intervux
# Local SQLite fallback (runs with zero database installation required):
# DATABASE_URL=sqlite:///./intervux.db

# Authentication Security
JWT_SECRET=intervux-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services (Leave blank to use Development / Mock Mode)
OPENAI_API_KEY=
WHISPER_MODEL=base

# Network URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
